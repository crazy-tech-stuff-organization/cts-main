---
import { Button } from "./ui/button";
---

<section class="relative overflow-hidden">
  <div
    class="absolute inset-0 bg-linear-to-br from-primary/10 via-background to-background"
  >
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32">
    <div class="text-center max-w-3xl mx-auto">
      <div
        class="inline-block mb-4 px-4 py-1.5 bg-primary/10 border border-primary/20 rounded-full"
      >
        <span class="text-sm font-medium text-primary"
          >Aprende a programar en 2025</span
        >
      </div>
      <h1
        class="text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight mb-6 text-balance"
      >
        La escuela para <span class="text-primary">desarrolladores</span> del futuro
      </h1>
      <p class="text-xl text-muted-foreground mb-8 leading-relaxed text-pretty">
        Domina las tecnologías más demandadas del mercado. Desde desarrollo web
        hasta inteligencia artificial, con instructores expertos y proyectos
        reales.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" className="text-base"> Explorar Cursos </Button>
        <Button
          size="lg"
          variant="outline"
          className="text-base bg-transparent"
        >
          Ver Demo Gratis
        </Button>
      </div>
    </div>
  </div>
</section>
